# BiteCheck Environment Configuration
# Copy this file to .env and populate your actual secrets:
# cp .env.example .env

# Google Gemini API Key (Required for Agent 1 Multimodal Vision)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Runtime Settings
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
